{
 "doctype": "DocType",
 "name": "Horizon Command Settings",
 "module": "Horizon Command",
 "issingle": 1,
 "custom": 0,
 "engine": "InnoDB",
 "field_order": [
  "sb_colors", "primary_color", "accent_color", "success_color", "column_break_c1",
  "pending_color", "approved_color", "rejected_color",
  "sb_type", "font_family", "column_break_t1", "control_radius",
  "sb_density", "form_density", "column_break_d1", "form_density_help",
  "sb_sidebar", "sidebar_default_state", "column_break_s1",
  "rail_collapsed_width", "rail_open_width",
  "sb_reset", "reset_to_defaults"
 ],
 "fields": [
  {"fieldname": "sb_colors", "fieldtype": "Section Break", "label": "الألوان"},
  {"fieldname": "primary_color", "fieldtype": "Color", "label": "اللون الأساسي (الصوت)", "default": "#1D2D44"},
  {"fieldname": "accent_color", "fieldtype": "Color", "label": "لون الإبراز على الأسطح الداكنة", "default": "#8FA8CC"},
  {"fieldname": "success_color", "fieldtype": "Color", "label": "لون النجاح", "default": "#5083BC",
   "description": "مخصص لتأكيدات النجاح فقط — مش لون زر عام."},
  {"fieldname": "column_break_c1", "fieldtype": "Column Break"},
  {"fieldname": "pending_color", "fieldtype": "Color", "label": "لون: معلّق", "default": "#B8860B"},
  {"fieldname": "approved_color", "fieldtype": "Color", "label": "لون: معتمد", "default": "#4E7A5C"},
  {"fieldname": "rejected_color", "fieldtype": "Color", "label": "لون: مرفوض/إلغاء", "default": "#B04A3F"},

  {"fieldname": "sb_type", "fieldtype": "Section Break", "label": "الخط والحواف"},
  {"fieldname": "font_family", "fieldtype": "Select", "label": "الخط",
   "options": "Tajawal\nCairo\nInter\nSystem Default", "default": "Tajawal"},
  {"fieldname": "column_break_t1", "fieldtype": "Column Break"},
  {"fieldname": "control_radius", "fieldtype": "Int", "label": "استدارة الحواف (px)", "default": 7},

  {"fieldname": "sb_density", "fieldtype": "Section Break", "label": "الكثافة"},
  {"fieldname": "form_density", "fieldtype": "Select", "label": "كثافة النماذج والحقول",
   "options": "مضغوط (Command Center)\nعادي", "default": "مضغوط (Command Center)",
   "description": "الفرق الرئيسي بين هذا التطبيق وHorizon Theme العادي — قابل للتعديل هنا."},
  {"fieldname": "column_break_d1", "fieldtype": "Column Break"},
  {"fieldname": "form_density_help", "fieldtype": "HTML",
   "options": "<div style='font-size:.8rem;color:#69727F;padding-top:22px'>مضغوط = حقول أصغر وأقرب لبعض (الافتراضي، مناسب للاستخدام المكثف). عادي = نفس تباعد Horizon Theme القياسي.</div>"},

  {"fieldname": "sb_sidebar", "fieldtype": "Section Break", "label": "الشريط الجانبي"},
  {"fieldname": "sidebar_default_state", "fieldtype": "Select", "label": "الحالة الافتراضية عند فتح الصفحة",
   "options": "مفتوح (بالأسماء)\nمقفول (أيقونات فقط)", "default": "مفتوح (بالأسماء)"},
  {"fieldname": "column_break_s1", "fieldtype": "Column Break"},
  {"fieldname": "rail_collapsed_width", "fieldtype": "Int", "label": "العرض وهو مقفول (px)", "default": 68},
  {"fieldname": "rail_open_width", "fieldtype": "Int", "label": "العرض وهو مفتوح (px)", "default": 232},

  {"fieldname": "sb_reset", "fieldtype": "Section Break", "label": "إعادة الضبط"},
  {"fieldname": "reset_to_defaults", "fieldtype": "Button", "label": "استرجاع القيم الافتراضية"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1}
 ],
 "quick_entry": 0,
 "track_changes": 1
}
